{
  "name": "wdeaf-design-system-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "tsc -b && vite build",
    "preview": "node server/index.mjs",
    "test": "tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "start": "node server/index.mjs",
    "user:add": "node server/add-user.mjs",
    "build:pages": "npm run build",
    "preview:pages": "vite preview --host 127.0.0.1",
    "check:pages": "node scripts/check-pages.mjs",
    "build:server": "tsc -b && vite build --mode server",
    "ds:generate": "node scripts/ds-generate.mjs",
    "ds:validate": "node scripts/ds-generate.mjs --check && tsc -p tsconfig.contract.json && tsx scripts/ds-validate.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.contract.json",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
